{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: configure demo",
            "type": "process",
            "command": "cmake",
            "args": ["-S", "${workspaceFolder}", "-B", "${workspaceFolder}/build", "-DBUILD_TESTING=OFF"],
            "problemMatcher": []
        },
        {
            "label": "CMake: build demo",
            "type": "process",
            "command": "cmake",
            "args": ["--build", "${workspaceFolder}/build", "--config", "Debug"],
            "dependsOn": "CMake: configure demo",
            "problemMatcher": ["$gcc"],
            "group": {"kind": "build", "isDefault": true}
        }
    ]
}
